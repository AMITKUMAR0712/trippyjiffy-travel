{
  "name": "trippyjiffy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TrippyJiffy website + Leads Extractor",
  "scripts": {
    "setup:production": "bash scripts/setup-production.sh",
    "deploy": "bash scripts/deploy.sh",
    "build:all": "bash scripts/build-all.sh",
    "install:all": "bash scripts/install-all.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "fix:production": "bash scripts/fix-production.sh",
    "nginx:generate": "bash scripts/generate-nginx-config.sh",
    "nginx:rollback": "bash scripts/generate-nginx-rollback.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
