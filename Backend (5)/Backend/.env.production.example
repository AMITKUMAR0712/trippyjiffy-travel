# TrippyJiffy Backend — copy to .env on server:
#   cp .env.production.example .env

DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=trippyjiffy_db
DB_PORT=3306
PORT=5005

DATABASE_URL="mysql://your_mysql_user:your_mysql_password@localhost:3306/trippyjiffy_db"

JWT_SECRET=change_this_to_a_long_random_secret

GMAIL_USER=your-email@trippyjiffy.com
GMAIL_PASS=your_gmail_app_password

ADMIN_EMAIL=your-email@trippyjiffy.com
EMAIL_PASS=your_gmail_app_password
BASE_URL=https://trippyjiffy.com

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# Google Reviews widget
GOOGLE_API_KEY=your_google_api_key
GOOGLE_PLACE_ID=your_google_place_id

NODE_ENV=production
