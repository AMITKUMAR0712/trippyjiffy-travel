# Leads Extractor — copy to .env on server:
#   cp .env.production.example .env
# Also copy to backend/.env:
#   cp .env.production.example backend/.env

# Google Places + Geocoding API (enable in Google Cloud Console)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# PostgreSQL (Leads only — NOT MySQL)
DATABASE_URL=postgresql://postgres:CHANGE_PASSWORD@127.0.0.1:5433/travel_leads?schema=public

# Runs separately from TrippyJiffy API (5005)
PORT=5006
API_PREFIX=/leads-api

JWT_SECRET=change_this_leads_jwt_secret_separately

FRONTEND_URL=https://trippyjiffy.com
NODE_ENV=production
