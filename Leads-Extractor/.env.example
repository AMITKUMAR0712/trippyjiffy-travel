# Google Maps API Key (Places API + Geocoding API must be enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/travel_leads?schema=public

# Leads API — separate from TrippyJiffy (port 5005)
PORT=5006
API_PREFIX=/leads-api

# JWT Secret (change in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# TrippyJiffy origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development
